    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-session": "^1.19.0",
    "googleapis": "^144.0.0",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.12.2",
    "next": "^16.3.3",
